// Atlas: one Worker, one person agent per owner (a Durable Object with its own
// SQLite). The app is served from ../app/dist. Owner step after deploy:
// `npx wrangler secret put ATLAS_OWNER_SECRET` (see docs/M0.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "ai": { "binding": "AI" },
  // Browser Run (§9.1): Atlas's browser, with its live view on the stage.
  "browser": { "binding": "BROWSER" },
  // Code Mode (§9.1): one small program over Atlas's own tools, run in a Dynamic Worker.
  "worker_loaders": [{ "binding": "LOADER" }],
  // Files Atlas makes (§21.7). Wrangler creates the bucket on the first deploy.
  "r2_buckets": [{ "binding": "FILES" }],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/preview/*", "/mcp/*"]
  },
  // The workspace (§9.1): a container per person, started by its Durable Object from Cloudflare's
  // managed Debian image, so deploying needs no Docker.
  "containers": [{ "class_name": "Workspace", "scheduling_policy": "durable_object" }],
  "durable_objects": {
    "bindings": [
      { "name": "PersonAgent", "class_name": "PersonAgent" },
      { "name": "WORKSPACE", "class_name": "Workspace" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Workspace"] }
  ],
  "observability": { "enabled": true }
}
